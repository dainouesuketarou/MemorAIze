generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Group {
    id          String  @id @default(uuid())
    name        String  @unique
    description String?
    userId      String
    user        User    @relation(fields: [userId], references: [id])
    decks       Deck[]  @relation("DeckGroups")
}

model Deck {
    id           String         @id @default(uuid())
    title        String
    description  String?
    lastStudied  DateTime?
    cardCount    Int
    progress     Float
    groups       Group[]        @relation("DeckGroups")
    cards        Card[]
    StudyHistory StudyHistory[]
    userId       String
    user         User           @relation(fields: [userId], references: [id])
    deckSettings DeckSetting[]     @relation("DeckDeckSettings")
    shareCode    String?        @unique
}

enum CardStatus {
    UNLEARNED // 未学習
    MASTERED // 覚えた
    STRUGGLING // 苦手
}

model Card {
    id     String     @id @default(uuid())
    front  String
    back   String
    order  Int
    status CardStatus @default(UNLEARNED)
    favorite Boolean @default(false)
    deck   Deck       @relation(fields: [deckId], references: [id])
    deckId String
}

enum FilterMode {
  UNLEARNED
  MASTERED
  STRUGGLING
  FAVORITE
}

model DeckSetting {
  id         String     @id @default(uuid())
  userId     String
  deckId     String
  autoSpeak  Boolean    @default(false)
  reverse    Boolean    @default(false)
  filterMode FilterMode[] @default([])
  shuffle    Boolean    @default(false)
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())

  user User @relation("UserDeckSettings", fields: [userId], references: [id])
  deck Deck @relation("DeckDeckSettings", fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
}

model StudyHistory {
    id        String   @id @default(uuid())
    deckId    String
    deck      Deck     @relation(fields: [deckId], references: [id])
    progress  Int // 進捗率（0-100）
    createdAt DateTime @default(now())
}

model User {
    id            String    @id @default(uuid())
    email         String    @unique
    name          String?
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    decks         Deck[]
    Group         Group[]
    deckSettings  DeckSetting[]    @relation("UserDeckSettings")
    emailVerified DateTime?
    Account       Account[]
    Session       Session[]
    loginHistory  LoginHistory[]
}

model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model AiGenerationLimit {
    id        String   @id @default(cuid())
    userId    String
    month     DateTime
    count     Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, month])
}

model LoginHistory {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    loginAt   DateTime @default(now())
    createdAt DateTime @default(now())

    @@index([userId, loginAt])
}
